/// @file critical_section
/// @brief Scoped interrupt masking.
#pragma once

namespace gba::bits {
    extern "C" unsigned int _stdgba_enter_critical_section() noexcept;
    extern "C" void _stdgba_exit_critical_section(unsigned int previousInterruptState) noexcept;
} // namespace gba::bits

namespace gba {

    /// @brief Disables interrupts for the lifetime of the object.
    ///
    /// Construction saves and sets the CPSR IRQ disable flag. Destruction restores
    /// the saved flag, so critical sections may be nested safely.
    ///
    /// @code{.cpp}
    /// {
    ///     const gba::critical_section section;
    ///     // Interrupts are disabled here.
    /// }
    ///
    /// if (const gba::critical_section section{}) {
    ///     // Interrupts are disabled here.
    /// }
    /// @endcode
    struct critical_section final {
        [[gnu::always_inline]]
        critical_section() noexcept
            : m_previous_interrupt_state(bits::_stdgba_enter_critical_section()) {}

        [[gnu::always_inline]]
        ~critical_section() noexcept {
            bits::_stdgba_exit_critical_section(m_previous_interrupt_state);
        }

        critical_section(const critical_section&) = delete;
        critical_section& operator=(const critical_section&) = delete;
        critical_section(critical_section&&) = delete;
        critical_section& operator=(critical_section&&) = delete;

        /// @brief Supports using a critical section as an if condition.
        explicit operator bool() const noexcept { return true; }

    private:
        unsigned int m_previous_interrupt_state;
    };

} // namespace gba
