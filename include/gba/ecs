/// @file ecs
/// @brief Static Entity-Component-System for GBA.
///
/// A zero-allocation, compile-time ECS with flat dense storage. All component
/// pools are inline arrays indexed by entity slot - no heap, no sparse sets,
/// no type-erasure overhead. Designed for ARM7TDMI where memory indirection
/// and dynamic allocation are the primary performance killers.
///
/// ## Quick Start
///
/// @code{.cpp}
/// #include <gba/ecs>
///
/// // Components - sizes are automatically padded internally, no manual padding needed
/// struct position { int x, y; };   // 8 bytes
/// struct velocity { int vx, vy; }; // 8 bytes
/// struct health   { int hp; };     // 4 bytes
///
/// // Registry: max 128 entities, compile-time component list
/// gba::ecs::registry<128, position, velocity, health> world;
///
/// // Create entities and attach components
/// auto player = world.create();
/// world.emplace<position>(player, 100, 50);
/// world.emplace<velocity>(player, 1, 0);
/// world.emplace<health>(player, 100);
///
/// // Iterate with range-based for (structured bindings)
/// for (auto [pos, vel] : world.view<position, velocity>()) {
///     pos.x += vel.vx;
///     pos.y += vel.vy;
/// }
///
/// // Or use .each() callback style
/// world.view<position, velocity>().each([](position& pos, const velocity& vel) {
///     pos.x += vel.vx;
///     pos.y += vel.vy;
/// });
///
/// // Include the entity ID in a range-based for loop
/// for (auto&& [entity, pos, vel] : world.view<gba::ecs::with_entity, position, velocity>()) {
///     pos.x += vel.vx;
/// }
///
/// // with_entity also requires the entity ID as the first callback argument
/// world.view<gba::ecs::with_entity, health>().each([](gba::entity id, health& hp) {
///     hp.hp += id.slot;
/// });
///
/// // Entity lifecycle
/// world.destroy(player);
/// // player is now invalid - generation mismatch detects use-after-destroy
/// @endcode
///
/// ## Component Groups
///
/// Component groups provide logical organization for related components without
/// any runtime overhead - they are completely flattened at compile time.
///
/// @code{.cpp}
/// // Group related components together
/// using physics = gba::ecs::group<position, velocity>;
/// using gameplay = gba::ecs::group<health, mana>;
///
/// // Single registry with groups instead of a long component list
/// gba::ecs::registry<128, physics, gameplay> world;
/// // Internally equivalent to:
/// // gba::ecs::registry<128, position, velocity, health, mana>
///
/// // Use components through the registry as normal
/// for (auto [pos, vel] : world.view<position, velocity>()) {
///     pos.x += vel.vx;
/// }
///
/// // You can also mix groups and individual components
/// using player_data = gba::ecs::group<position, velocity>;
/// gba::ecs::registry<128, player_data, health, score> world2;
/// @endcode
///

/// Component pool storage automatically rounds each component's per-slot
/// stride up to the next power of two (`std::bit_ceil`), so shift-based
/// addressing is used internally (critical for ARM7TDMI, which lacks a
/// barrel-shifter MUL path for indexed loads) without requiring components
/// to have a power-of-two `sizeof` themselves. No manual padding is needed:
///
/// @code{.cpp}
/// struct sprite_id {
///     std::uint8_t id;   // sizeof(sprite_id) == 1, stride rounds to 1
/// };
/// struct entry {
///     std::uint8_t a, b, c;  // sizeof(entry) == 3, stride rounds to 4
/// };
/// @endcode
///
/// ## Constexpr Support
///
/// All registry operations are `constexpr`. Invalid operations (capacity
/// overflow, double-emplace, use-after-destroy) produce clear compiler
/// diagnostics when used in constant-evaluation contexts.
///
/// @code{.cpp}
/// static constexpr auto result = [] {
///     gba::ecs::registry<4, int> reg;
///     auto e = reg.create();
///     reg.emplace<int>(e, 42);
///     return reg.get<int>(e);
/// }();
/// static_assert(result == 42);
/// @endcode
#pragma once

#include <gba/bits/ecs/entity.hpp>
#include <gba/bits/ecs/group.hpp>
#include <gba/bits/ecs/registry.hpp>
